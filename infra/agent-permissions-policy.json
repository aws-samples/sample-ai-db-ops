{
  "Version": "2012-10-17",
  "Comment": "Least-privilege policy for the DB Ops agent. Replace the 123456789012 account id, us-east-1 region, and the dbops-* resource-name prefixes with the values for your deployment before use.",
  "Statement": [
    {
      "Sid": "ReadDbOpsSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:123456789012:secret:dbops/*"
      ]
    },
    {
      "Sid": "RdsReadOnly",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "rds:DescribeDBClusters",
        "rds:DescribeDBSnapshots",
        "rds:DescribeDBClusterSnapshots",
        "rds:DescribeDBSubnetGroups",
        "rds:DescribeDBParameters",
        "rds:DescribeDBParameterGroups",
        "rds:DescribeDBClusterParameters",
        "rds:DescribeDBClusterParameterGroups",
        "rds:DescribeDBInstanceAutomatedBackups",
        "rds:DescribeReservedDBInstances",
        "rds:DescribePendingMaintenanceActions",
        "rds:DescribeEvents",
        "rds:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RdsManageDbOpsResources",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:CreateDBClusterSnapshot",
        "rds:CreateDBSnapshot",
        "rds:ModifyDBCluster",
        "rds:ModifyDBInstance",
        "rds:CopyDBClusterSnapshot",
        "rds:CopyDBSnapshot",
        "rds:RestoreDBClusterFromSnapshot",
        "rds:AddTagsToResource"
      ],
      "Resource": [
        "arn:aws:rds:us-east-1:123456789012:cluster:dbops-*",
        "arn:aws:rds:us-east-1:123456789012:db:dbops-*",
        "arn:aws:rds:us-east-1:123456789012:cluster-snapshot:dbops-*",
        "arn:aws:rds:us-east-1:123456789012:snapshot:dbops-*",
        "arn:aws:rds:us-east-1:123456789012:subgrp:dbops-*"
      ]
    },
    {
      "Sid": "DynamoDbReadOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListTables",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:DescribeBackup",
        "dynamodb:ListBackups",
        "dynamodb:DescribeContributorInsights",
        "dynamodb:ListExports"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DynamoDbManageDbOpsTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateBackup",
        "dynamodb:UpdateContributorInsights",
        "dynamodb:UpdateTable",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:PutItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:BatchGetItem",
        "dynamodb:ExportTableToPointInTime"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:123456789012:table/dbops-*",
        "arn:aws:dynamodb:us-east-1:123456789012:table/dbops-*/index/*",
        "arn:aws:dynamodb:us-east-1:123456789012:table/dbops-*/backup/*",
        "arn:aws:dynamodb:us-east-1:123456789012:table/dbops-*/export/*"
      ]
    },
    {
      "Sid": "CloudWatchMetricsScoped",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": [
            "AWS/RDS",
            "AWS/DynamoDB"
          ]
        }
      }
    },
    {
      "Sid": "AppAutoScalingReadOnly",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:DescribeScalableTargets",
        "application-autoscaling:DescribeScalingPolicies",
        "application-autoscaling:DescribeScalingActivities",
        "application-autoscaling:DescribeScheduledActions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AppAutoScalingManageDbOps",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:RegisterScalableTarget",
        "application-autoscaling:DeregisterScalableTarget",
        "application-autoscaling:PutScalingPolicy",
        "application-autoscaling:DeleteScalingPolicy"
      ],
      "Resource": [
        "arn:aws:application-autoscaling:us-east-1:123456789012:scalable-target/*"
      ],
      "Condition": {
        "StringEquals": {
          "application-autoscaling:service-namespace": "rds"
        }
      }
    },
    {
      "Sid": "S3UploadsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bedrock-agentcore-codebuild-sources-123456789012-us-east-1",
        "arn:aws:s3:::bedrock-agentcore-codebuild-sources-123456789012-us-east-1/*"
      ]
    }
  ]
}
