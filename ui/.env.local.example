# ─────────────────────────────────────────────────────────────────────────────
# DB Ops Console — Environment Configuration
# Copy this file to `.env.local` and fill in the values for your account.
# `.env.local` is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# AWS account / region
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# Default user identity (shows up in audit logs and gamification)
NEXT_PUBLIC_USER_ID=dbops-user

# Python interpreter used by /api/invoke to call boto3.bedrock-agentcore.
# Must have boto3 installed. Defaults to `python3.12` from $PATH.
# PYTHON_BIN=/usr/local/bin/python3.12

# AgentCore Runtime ARNs — populate after running `agentcore deploy`
# in each deploy/<engine>_agent directory. Example format:
#   arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/dbops_postgresql-AbCdEfGh12
POSTGRESQL_AGENT_ARN=
MYSQL_AGENT_ARN=
ORACLE_AGENT_ARN=
DYNAMODB_AGENT_ARN=

# Optional: override the S3 bucket used by /api/upload.
# Defaults to bedrock-agentcore-codebuild-sources-<AWS_ACCOUNT_ID>-<AWS_REGION>.
# UPLOAD_BUCKET=
# UPLOAD_PREFIX=dbops-uploads

# Force the region used for AgentCore invocations (overrides ambient AWS_REGION)
AGENT_REGION=us-east-1

# ─── Admin Console (dev only) ────────────────────────────────────────────
# Bypass the dbops-admins DynamoDB lookup when developing locally. Audit
# events still record the action; only the role check is skipped. Only
# honored when NODE_ENV != "production". Leave unset in real environments.
# ADMIN_DEV_BYPASS=1
